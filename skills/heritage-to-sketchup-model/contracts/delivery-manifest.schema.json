{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.delivery_manifest.2026-08-06",
  "title": "Immutable Delivery Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "project_id", "revision", "status", "created_at", "project_root", "source_contracts", "acceptance", "active_model", "delivered_model", "evidence", "report", "unresolved"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.delivery_manifest.2026-08-06"},
    "package_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "packaged_for_delivery_gate"},
    "created_at": {"type": "string", "format": "date-time"},
    "project_root": {"type": "string", "minLength": 1},
    "source_contracts": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/contract_artifact"}},
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmation_id", "instruction", "accepted_at", "acceptance_basis_sha256", "active_model_sha256", "machine_result_sha256", "independent_review_sha256"],
      "properties": {
        "confirmation_id": {"type": "string", "minLength": 1}, "instruction": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "format": "date-time"}, "acceptance_basis_sha256": {"$ref": "#/$defs/sha256"},
        "active_model_sha256": {"$ref": "#/$defs/sha256"}, "machine_result_sha256": {"$ref": "#/$defs/sha256"},
        "independent_review_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "active_model": {"$ref": "#/$defs/artifact"},
    "delivered_model": {"$ref": "#/$defs/artifact"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "report": {"$ref": "#/$defs/artifact"},
    "unresolved": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "contract_artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": {"kind": {"enum": ["source-index", "building-topology", "sketchup-build", "independent-qa"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": {"kind": {"enum": ["cad_provenance", "model_provenance", "machine_result", "independent_review", "cad_view", "model_view", "overlay"]}, "source_view_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
