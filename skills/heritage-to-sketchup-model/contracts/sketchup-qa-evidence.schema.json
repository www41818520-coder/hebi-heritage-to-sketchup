{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.sketchup_qa_evidence.2026-08-06",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "qa_plan", "active_model", "derivation", "production_root", "untracked_entity_ids", "views", "unresolved"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.sketchup_qa_evidence.2026-08-06"},
    "status": {"const": "exported_read_only"},
    "qa_plan": {"$ref": "#/$defs/artifact"},
    "active_model": {"$ref": "#/$defs/artifact"},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["id", "agent_role"], "properties": {"id": {"type": "string", "minLength": 1}, "agent_role": {"const": "active_sketchup_qa_export"}}},
    "production_root": {"type": "string", "minLength": 1},
    "untracked_entity_ids": {"type": "array", "maxItems": 0},
    "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/view"}},
    "unresolved": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["xmin", "ymin", "xmax", "ymax"], "properties": {"xmin": {"type": "number"}, "ymin": {"type": "number"}, "xmax": {"type": "number"}, "ymax": {"type": "number"}}},
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "entity": {"type": "object", "additionalProperties": false, "required": ["topology_id", "category", "persistent_entity_ids", "bounds", "outline", "true_opening"], "properties": {"topology_id": {"type": "string", "minLength": 1}, "category": {"enum": ["envelope", "wall", "opening", "curtain_wall", "sweep", "canopy", "roof", "slab", "material_boundary", "other_model_driving"]}, "persistent_entity_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "bounds": {"$ref": "#/$defs/bounds"}, "outline": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}}, "true_opening": {"type": "boolean"}}},
    "view": {"type": "object", "additionalProperties": false, "required": ["source_view_id", "qa_view", "role", "model_view", "silhouette", "entities"], "properties": {"source_view_id": {"type": "string", "minLength": 1}, "qa_view": {"type": "string", "minLength": 1}, "role": {"enum": ["plan", "roof_plan", "elevation", "section"]}, "model_view": {"$ref": "#/$defs/artifact"}, "silhouette": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point"}}, "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}}}}
  }
}
