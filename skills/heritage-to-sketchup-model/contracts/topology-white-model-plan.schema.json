{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.topology_white_model_plan.2026-08-05",
  "title": "Executable Topology White Model Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "project_id", "revision", "status", "execution_allowed", "topology_plan_id", "project_root", "upstream", "derivation", "coordinate_system", "registrations", "control_basis", "levels", "walls", "internal_walls", "slabs", "roofs", "roof_lights", "openings", "curtain_walls", "sweeps", "canopies", "materials", "unresolved", "white_model_output"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.topology_white_model_plan.2026-08-05"},
    "contract_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "ready_for_white_model"}, "execution_allowed": {"const": true}, "topology_plan_id": {"type": "string", "minLength": 1}, "project_root": {"type": "string", "minLength": 1},
    "upstream": {"$ref": "building-topology.schema.json#/$defs/upstream"},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["id", "agent_role"], "properties": {"id": {"type": "string", "minLength": 1}, "agent_role": {"const": "topology_derivation"}}},
    "coordinate_system": {"$ref": "topology-derivation.schema.json#/$defs/coordinate_system"},
    "registrations": {"type": "array", "minItems": 1, "items": {"$ref": "building-topology.schema.json#/$defs/registration"}},
    "control_basis": {"$ref": "topology-derivation.schema.json#/$defs/control_basis"},
    "levels": {"type": "array", "minItems": 1, "items": {"$ref": "building-topology.schema.json#/$defs/level"}},
    "walls": {"type": "array", "minItems": 3, "items": {"$ref": "building-topology.schema.json#/$defs/wall"}},
    "internal_walls": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/internal_wall"}},
    "slabs": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/slab"}},
    "roofs": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/roof"}},
    "roof_lights": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/roof_light"}},
    "openings": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/opening"}},
    "curtain_walls": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/curtain_wall"}},
    "sweeps": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/sweep"}},
    "canopies": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/canopy"}},
    "access_elements": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/access_element"}},
    "columns": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/column"}},
    "materials": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/material"}},
    "unresolved": {"type": "array", "maxItems": 0},
    "white_model_output": {"$ref": "topology-derivation.schema.json#/$defs/white_model_output"}
  }
}
