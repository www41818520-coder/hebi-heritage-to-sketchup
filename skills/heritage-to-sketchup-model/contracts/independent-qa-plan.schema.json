{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.independent_qa_plan.2026-08-06",
  "title": "Compiled Independent QA Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "project_id", "revision", "status", "execution_allowed", "project_root", "upstream", "derivation", "tolerance_mm", "active_model", "views", "outputs", "unresolved"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.independent_qa_plan.2026-08-06"},
    "contract_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "ready_for_model_export"},
    "execution_allowed": {"const": true},
    "project_root": {"type": "string", "minLength": 1},
    "upstream": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/upstream"}},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["id", "agent_role"], "properties": {"id": {"type": "string", "minLength": 1}, "agent_role": {"const": "independent_cad_qa"}}},
    "tolerance_mm": {"type": "number", "exclusiveMinimum": 0},
    "active_model": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "production_root"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "production_root": {"type": "string", "minLength": 1}}},
    "views": {"type": "array", "minItems": 1, "items": {"$ref": "independent-qa-derivation.schema.json#/$defs/view"}},
    "outputs": {"$ref": "independent-qa-derivation.schema.json#/properties/outputs"},
    "unresolved": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "upstream": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": {"kind": {"enum": ["source-index", "building-topology", "sketchup-build", "independent-qa-derivation"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
