{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.sketchup_production_plan.2026-08-06",
  "title": "Executable SketchUp Production Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "project_id", "revision", "status", "execution_allowed", "build_plan_id", "project_root", "upstream", "derivation", "target", "required_topology_ids", "opening_assemblies", "curtain_wall_systems", "material_assignments", "generator", "unresolved"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.sketchup_production_plan.2026-08-06"},
    "contract_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "ready_for_sketchup"}, "execution_allowed": {"const": true}, "build_plan_id": {"type": "string", "minLength": 1}, "project_root": {"type": "string", "minLength": 1},
    "upstream": {"$ref": "building-topology.schema.json#/$defs/upstream"},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["id", "agent_role"], "properties": {"id": {"type": "string", "minLength": 1}, "agent_role": {"const": "production_specification"}}},
    "target": {"$ref": "sketchup-build-derivation.schema.json#/$defs/target"},
    "required_topology_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "opening_assemblies": {"type": "array", "items": {"allOf": [{"$ref": "sketchup-build-derivation.schema.json#/$defs/opening_assembly"}, {"properties": {"status": {"const": "verified"}, "family_id": {"type": "string", "minLength": 1}, "frame_width_mm": {"type": "number", "exclusiveMinimum": 0}, "frame_depth_mm": {"type": "number", "exclusiveMinimum": 0}, "inset_mm": {"type": "number", "minimum": 0}, "panel_type": {"enum": ["void_only", "glass", "solid", "mixed"]}, "evidence": {"type": "array", "minItems": 1}}}]}},
    "curtain_wall_systems": {"type": "array", "items": {"allOf": [{"$ref": "sketchup-build-derivation.schema.json#/$defs/curtain_wall_system"}, {"properties": {"status": {"const": "verified"}, "family_id": {"type": "string", "minLength": 1}, "frame_width_mm": {"type": "number", "exclusiveMinimum": 0}, "frame_depth_mm": {"type": "number", "exclusiveMinimum": 0}, "inset_mm": {"type": "number", "minimum": 0}, "panel_type": {"enum": ["glass", "solid", "mixed"]}, "evidence": {"type": "array", "minItems": 1}}}]}},
    "material_assignments": {"type": "array", "items": {"allOf": [{"$ref": "sketchup-build-derivation.schema.json#/$defs/material_assignment"}, {"properties": {"status": {"const": "verified"}, "display_name": {"type": "string", "minLength": 1}, "rgba": {"type": "array"}, "target_topology_ids": {"type": "array", "minItems": 1}, "evidence": {"type": "array", "minItems": 1}}}]}},
    "generator": {"type": "object", "additionalProperties": false, "required": ["module", "root_group", "version"], "properties": {"module": {"const": "HEBIProductionBuild"}, "root_group": {"const": "HEBI_PRODUCTION_BUILD_2026_08_06"}, "version": {"const": "2026-08-06"}}},
    "unresolved": {"type": "array", "maxItems": 0}
  }
}
