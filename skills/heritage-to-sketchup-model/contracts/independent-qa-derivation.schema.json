{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.independent_qa_derivation.2026-08-06",
  "title": "Independent CAD QA Derivation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "project_id", "revision", "status", "upstream", "derivation", "tolerance_mm", "views", "outputs", "blocking_reasons", "unresolved"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.independent_qa_derivation.2026-08-06"},
    "contract_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["cad_expectations_required", "ready_for_compile"]},
    "upstream": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/artifact"}},
    "derivation": {"$ref": "#/$defs/derivation"},
    "tolerance_mm": {"type": "number", "exclusiveMinimum": 0},
    "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/view"}},
    "outputs": {
      "type": "object", "additionalProperties": false,
      "required": ["qa_plan_path", "model_evidence_path", "model_view_dir", "overlay_dir", "machine_result_path", "review_path", "contract_path"],
      "properties": {
        "qa_plan_path": {"type": "string", "minLength": 1},
        "model_evidence_path": {"type": "string", "minLength": 1},
        "model_view_dir": {"type": "string", "minLength": 1},
        "overlay_dir": {"type": "string", "minLength": 1},
        "machine_result_path": {"type": "string", "minLength": 1},
        "review_path": {"type": "string", "minLength": 1},
        "contract_path": {"type": "string", "minLength": 1}
      }
    },
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {"kind": {"enum": ["source-index", "building-topology", "sketchup-build"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "derivation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "agent_role"],
      "properties": {"id": {"type": "string"}, "agent_role": {"const": "independent_cad_qa"}}
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["xmin", "ymin", "xmax", "ymax"],
      "properties": {"xmin": {"type": "number"}, "ymin": {"type": "number"}, "xmax": {"type": "number"}, "ymax": {"type": "number"}}
    },
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "artifact_file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "source_entity_ids", "bounds", "critical"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["envelope", "wall", "opening", "curtain_wall", "sweep", "canopy", "roof", "slab", "material_boundary", "other_model_driving"]},
        "source_entity_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "bounds": {"$ref": "#/$defs/bounds"},
        "outline": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}},
        "critical": {"const": true}
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_point", "source_entity_ids"],
      "properties": {"id": {"type": "string", "minLength": 1}, "source_point": {"$ref": "#/$defs/point"}, "source_entity_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["source_view_id", "qa_view", "role", "source_bounds", "cad_view", "registration_id", "visible_topology_ids", "status", "silhouette", "orientation_anchors", "features"],
      "properties": {
        "source_view_id": {"type": "string", "minLength": 1},
        "qa_view": {"type": "string", "minLength": 1},
        "role": {"enum": ["plan", "roof_plan", "elevation", "section"]},
        "source_bounds": {"$ref": "#/$defs/bounds"},
        "cad_view": {"$ref": "#/$defs/artifact_file"},
        "registration_id": {"type": "string", "minLength": 1},
        "visible_topology_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["expectation_required", "verified"]},
        "silhouette": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "orientation_anchors": {"type": "array", "items": {"$ref": "#/$defs/anchor"}},
        "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}}
      }
    }
  }
}
