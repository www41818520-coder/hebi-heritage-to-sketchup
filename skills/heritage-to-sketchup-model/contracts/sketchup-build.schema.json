{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.sketchup_build.2026-08-06",
  "title": "Verified SketchUp Production Build",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "project_id", "revision", "status", "upstream", "generator", "build_plan", "execution_report", "active_model", "required_topology_ids", "element_results", "statistics", "geometry_checks", "unresolved"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.sketchup_build.2026-08-06"},
    "contract_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "status": {"const": "verified"},
    "upstream": {"$ref": "building-topology.schema.json#/$defs/upstream"},
    "generator": {"type": "object", "additionalProperties": false, "required": ["module", "version", "root_group", "root_persistent_id"], "properties": {"module": {"const": "HEBIProductionBuild"}, "version": {"const": "2026-08-06"}, "root_group": {"const": "HEBI_PRODUCTION_BUILD_2026_08_06"}, "root_persistent_id": {"type": "integer", "minimum": 1}}},
    "build_plan": {"$ref": "#/$defs/artifact"}, "execution_report": {"$ref": "#/$defs/artifact"}, "active_model": {"$ref": "#/$defs/artifact"},
    "required_topology_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "element_results": {"type": "array", "minItems": 1, "items": {"$ref": "sketchup-production-result.schema.json#/$defs/element_result"}},
    "statistics": {"$ref": "sketchup-production-result.schema.json#/$defs/statistics"},
    "geometry_checks": {"$ref": "sketchup-production-result.schema.json#/$defs/checks"},
    "unresolved": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "building-topology.schema.json#/$defs/sha256"}}}
  }
}
