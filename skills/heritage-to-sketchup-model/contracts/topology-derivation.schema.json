{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.topology_derivation.2026-08-05",
  "title": "Topology Derivation Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_id", "project_id", "revision", "status", "upstream", "derivation", "coordinate_system", "registrations", "control_basis", "levels", "walls", "internal_walls", "slabs", "roofs", "roof_lights", "openings", "curtain_walls", "sweeps", "canopies", "materials", "white_model_output", "blocking_reasons", "unresolved"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.topology_derivation.2026-08-05"},
    "contract_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["derivation_required", "ready_for_compile"]},
    "upstream": {"$ref": "building-topology.schema.json#/$defs/upstream"},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["id", "agent_role"], "properties": {"id": {"type": "string"}, "agent_role": {"const": "topology_derivation"}}},
    "coordinate_system": {"$ref": "#/$defs/coordinate_system"},
    "registrations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/derivation_registration"}},
    "control_basis": {"$ref": "#/$defs/control_basis"},
    "levels": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/level"}},
    "walls": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/wall"}},
    "internal_walls": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/internal_wall"}},
    "slabs": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/slab"}},
    "roofs": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/roof"}},
    "roof_lights": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/roof_light"}},
    "openings": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/opening"}},
    "curtain_walls": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/curtain_wall"}},
    "sweeps": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/sweep"}},
    "canopies": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/canopy"}},
    "access_elements": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/access_element"}},
    "columns": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/column"}},
    "materials": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/material"}},
    "white_model_output": {"$ref": "#/$defs/white_model_output"},
    "blocking_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved": {"type": "array"}
  },
  "$defs": {
    "coordinate_system": {
      "type": "object", "additionalProperties": false,
      "required": ["units", "origin", "x_axis", "y_axis", "z_axis", "elevation_datum"],
      "properties": {"units": {"const": "mm"}, "origin": {"$ref": "building-topology.schema.json#/$defs/point3"}, "x_axis": {"$ref": "building-topology.schema.json#/$defs/vector3"}, "y_axis": {"$ref": "building-topology.schema.json#/$defs/vector3"}, "z_axis": {"$ref": "building-topology.schema.json#/$defs/vector3"}, "elevation_datum": {"type": "string", "minLength": 1}}
    },
    "control_basis": {
      "type": "object", "additionalProperties": false, "required": ["priority", "control_mass"],
      "properties": {"priority": {"const": ["user_confirmation", "control_mass", "cad_measurement", "documented_default"]}, "control_mass": {"type": "object", "additionalProperties": false, "required": ["provided", "scope"], "properties": {"provided": {"type": "boolean"}, "scope": {"enum": ["none", "envelope_only"]}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}}
    },
    "derivation_registration": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_view_id", "qa_view", "role", "source_bounds", "transform", "visible_topology_ids", "anchor_evidence", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source_view_id": {"type": "string", "minLength": 1}, "qa_view": {"type": "string", "minLength": 1},
        "role": {"enum": ["plan", "roof_plan", "elevation", "section"]},
        "source_bounds": {"type": "object", "additionalProperties": false, "required": ["xmin", "ymin", "xmax", "ymax"], "properties": {"xmin": {"type": "number"}, "ymin": {"type": "number"}, "xmax": {"type": "number"}, "ymax": {"type": "number"}}},
        "section_cut_elevation_mm": {"type": "number"},
        "transform": {"type": "object", "additionalProperties": false, "required": ["source_origin", "origin", "x_axis", "y_axis", "scale"], "properties": {"source_origin": {"$ref": "building-topology.schema.json#/$defs/point"}, "origin": {"$ref": "building-topology.schema.json#/$defs/point3"}, "x_axis": {"$ref": "building-topology.schema.json#/$defs/vector3"}, "y_axis": {"$ref": "building-topology.schema.json#/$defs/vector3"}, "scale": {"type": "number", "exclusiveMinimum": 0}}},
        "visible_topology_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "anchor_evidence": {"type": "array", "items": {"$ref": "building-topology.schema.json#/$defs/evidence"}},
        "status": {"enum": ["candidate", "verified"]}, "suggestion_basis": {"type": "string"}, "review_note": {"type": "string"}
      }
    },
    "white_model_output": {
      "type": "object", "additionalProperties": false, "required": ["model_path", "result_path", "review_dir"],
      "properties": {"model_path": {"type": "string", "minLength": 1}, "result_path": {"type": "string", "minLength": 1}, "review_dir": {"type": "string", "minLength": 1}}
    }
  }
}
