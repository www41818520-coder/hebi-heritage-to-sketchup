{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.independent_qa_review.2026-08-06",
  "title": "Independent QA Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "machine_result", "reviewer", "view_results", "cross_view_checks", "unresolved"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.independent_qa_review.2026-08-06"},
    "status": {"enum": ["review_required", "verified"]},
    "machine_result": {"type": "object", "required": ["path", "sha256"]},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["id", "derivation_id"], "properties": {"id": {"type": "string"}, "derivation_id": {"type": "string"}}},
    "view_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_view_id", "status", "checks", "notes"], "properties": {"source_view_id": {"type": "string", "minLength": 1}, "status": {"enum": ["REVIEW", "PASS"]}, "checks": {"type": "object"}, "notes": {"type": "string"}}}},
    "cross_view_checks": {"type": "object"},
    "unresolved": {"type": "array"}
  }
}
