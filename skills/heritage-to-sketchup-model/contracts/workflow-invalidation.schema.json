{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cad_to_sketchup.workflow_invalidation.2026-08-06",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "invalidation_id", "project_id", "created_at", "status", "earliest_stage", "reason", "reported_by", "state_before", "affected_entries", "required_restart_stage"],
  "properties": {
    "schema": {"const": "cad_to_sketchup.workflow_invalidation.2026-08-06"},
    "invalidation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "rework_required"},
    "earliest_stage": {"enum": ["source-index", "building-topology", "sketchup-build", "independent-qa", "delivery-manifest"]},
    "reason": {"type": "string", "minLength": 1},
    "reported_by": {"enum": ["user", "independent_qa", "system"]},
    "state_before": {"$ref": "#/$defs/artifact"},
    "affected_entries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string", "minLength": 1}, "value": {"type": "object"}}}},
    "required_restart_stage": {"enum": ["reading", "topology", "build", "qa", "delivery"]}
  },
  "$defs": {"artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}}
}
